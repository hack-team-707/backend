NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resolve
DB_SSL=false
# Local development only. Keep false in staging and production.
DB_SYNCHRONIZE=true
# Production/staging: keep synchronize false and enable versioned migrations during deployment.
DB_RUN_MIGRATIONS=false
# 32-byte key encoded as exactly 64 hexadecimal characters; replace per environment.
DATA_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Generate once with: pnpm exec web-push generate-vapid-keys --json
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Start with NVIDIA NIM for development. Switch only AI_PROVIDER later.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=replace-with-nvidia-api-key
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Amazon Bedrock (uses AWS credential chain, no API key needed).
# Set AI_PROVIDER=bedrock to use. Ensure AWS credentials are configured (env vars, ~/.aws/credentials, or IAM role).
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=amazon.nova-micro-v1:0
BEDROCK_MODEL_COMPLEX=amazon.nova-pro-v1:0
# Federated opportunity search. Resolve marketplace is always consulted first.
EXTERNAL_OPPORTUNITIES_ENABLED=true
EXTERNAL_OPPORTUNITIES_TIMEOUT_MS=15000
# RF0: minimum weighted skill coverage required for an internal candidate.
MIN_INTERNAL_MATCH_COVERAGE=60
# RF0: generate a conservative initial guide when no qualified internal Solver exists.
NO_MATCH_AI_GUIDANCE_ENABLED=true
HIMALAYAS_API_URL=https://himalayas.app/jobs/api/search
FREELANCER_API_URL=https://www.freelancer.com/api/projects/0.1/projects/active/
# Optional for public active-project search; required only for protected Freelancer operations.
FREELANCER_OAUTH_TOKEN=
