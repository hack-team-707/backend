# Node environment (development, production)
NODE_ENV=development
PORT=3000

# JWT configuration
JWT_SECRET=your-jwt-secret-min-32-characters-change-in-production
JWT_EXPIRES_IN=1h
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=resolve-platform
JWT_AUDIENCE=resolve-platform-web

# Authentication V2 features (false by default; enable progressively)
AUTH_SESSION_V2_ENABLED=false
REFRESH_TOKEN_ENABLED=false
CSRF_ENFORCED=false
MFA_ENFORCED=false
LEGACY_JWT_ALLOWED=true

# Rate limiting
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# Redis (required for auth V2 and financial features when enabled)
# REDIS_URL=redis://localhost:6379

# MFA encryption (optional; required if MFA_ENFORCED=true)
# MFA_ENCRYPTION_KEY=your-32-byte-hex-key

# CORS and public URLs
CORS_ORIGINS=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/resolve
DB_SSL=false
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true

# Data encryption key (required; 64 hex characters)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Web Push notifications (optional; all three required together or none)
# VAPID_SUBJECT=mailto:your-email@example.com
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key

# AI provider (disabled, nvidia, openai, anthropic, gemini)
AI_PROVIDER=disabled
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# External talent sources
EXTERNAL_OPPORTUNITIES_ENABLED=true
EXTERNAL_OPPORTUNITIES_TIMEOUT_MS=15000
MIN_INTERNAL_MATCH_COVERAGE=60
NO_MATCH_AI_GUIDANCE_ENABLED=true
HIMALAYAS_API_URL=https://himalayas.app/jobs/api/search
FREELANCER_API_URL=https://www.freelancer.com/api/projects/0.1/projects/active/
# FREELANCER_OAUTH_TOKEN=your-freelancer-token
FREELANCER_ENABLED=true
FREELANCER_ENVIRONMENT=production
FREELANCER_BASE_URL=https://www.freelancer.com
FREELANCER_TIMEOUT_MS=8000

# Google Places (optional)
GOOGLE_PLACES_ENABLED=false
# GOOGLE_PLACES_API_KEY=your-google-places-key
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_LANGUAGE=es
GOOGLE_PLACES_REGION=PE
GOOGLE_PLACES_DEFAULT_RADIUS_METERS=10000
GOOGLE_PLACES_TIMEOUT_MS=8000

# Financial features (disabled by default)
FINANCIAL_FEATURE_ENABLED=false

# Mercado Pago configuration (required when FINANCIAL_FEATURE_ENABLED=true)
# MERCADO_PAGO_ACCESS_TOKEN=your-mercado-pago-access-token
# MERCADO_PAGO_WEBHOOK_SECRET=your-mercado-pago-webhook-secret
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
# MERCADO_PAGO_NOTIFICATION_URL=https://your-domain.com/api/payments/webhooks/mercado-pago
# MERCADO_PAGO_BACK_URLS={"success":"https://your-app.com/payments/success","failure":"https://your-app.com/payments/failure","pending":"https://your-app.com/payments/pending"}
MERCADO_PAGO_WEBHOOK_TOLERANCE_SECONDS=300
MERCADO_PAGO_MULTI_SELLER_SPLIT_ENABLED=false
